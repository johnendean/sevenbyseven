<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SevenBySeven.ServiceDefaults\SevenBySeven.ServiceDefaults.csproj" />
    <!-- Every module is composed into the host; ModuleCatalog finds them at startup. -->
    <ProjectReference Include="..\Modules\*\*.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Shared with the API while Scanning still identifies records in this process. -->
    <UserSecretsId>f2d3bf17-15e7-44ca-93e5-1e606a6d2ac8</UserSecretsId>
  </PropertyGroup>

</Project>
