<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SevenBySeven.ServiceDefaults\SevenBySeven.ServiceDefaults.csproj" />
    <!-- The modules' contracts only. The modules themselves run in the API, and this app
         reaches them over HTTP (docs/adr/0009). -->
    <ProjectReference Include="..\Modules\*.Contracts\*.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
