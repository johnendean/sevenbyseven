@implements IDisposable
@inject StackWatch Watch

@if (Watch.Current is { HasUnresolvedWork: true } stack)
{
    <a class="stack-indicator" href="stack">
        <span class="stack-indicator-dot" aria-hidden="true"></span>
        Stack in progress &mdash; @Describe(stack)
    </a>
}

@code {
    // A half-finished Stack is invisible the moment you navigate off its page, and with the
    // Stack held in the API it may not even have been started on this device. Invisible state
    // is how you end up rescanning a pile you already did.

    protected override void OnInitialized()
    {
        Watch.Changed += OnChanged;
        Watch.Start();
    }

    private static string Describe(StackSheet stack) =>
        stack.PendingCount switch
        {
            0 => $"{Counted(stack.Count)} captured",
            var pending when pending == stack.Count => $"{Counted(pending)} to confirm",
            var pending => $"{Counted(pending)} of {stack.Count} still to confirm",
        };

    private static string Counted(int count) => count == 1 ? "1 record" : $"{count} records";

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Watch.Changed -= OnChanged;
}
