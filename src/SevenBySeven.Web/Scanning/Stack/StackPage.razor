@page "/stack"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StackWatch Watch
@inject StackClient Stacks
@inject IOptions<DetectionOptions> Detection
@inject ILogger<StackPage> Logger

<PageTitle>Scan a stack</PageTitle>

<h1>Scan a stack</h1>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@* An empty Stack that is not capturing here has nothing to show, so it is offered as a
   new start: beginning again replaces it. *@
@if (Watch.Current is not { } stack || (stack.IsEmpty && !_capturing))
{
    @if (_probe is null)
    {
        <p class="stack-meta">Checking what this browser can do&hellip;</p>
    }
    else if (!Watch.IsLoaded)
    {
        <p class="stack-meta">Looking for a stack in progress&hellip;</p>
    }
    else if (_probe is { HasMediaDevices: true, IsSecureContext: true })
    {
        <p>
            Hold a record up to the camera. It is captured on its own once it is steady, and
            then the camera waits for the next one &mdash; take one away before presenting
            another. Up to @(_limits?.MaxStackSize.ToString() ?? "a handful of") records. Each one is identified in
            the background while you carry on, and you pick the matches once the pile is done.
        </p>

        <div class="stack-format">
            <label class="form-label" for="format">Records in this stack</label>
            <select id="format" class="form-select" value="@_format" @onchange="SetFormat">
                @foreach (var format in Enum.GetValues<Format>())
                {
                    <option value="@format">@FormatChoice(format)</option>
                }
            </select>
            <p class="stack-meta">
                Discogs is searched for these only, except by barcode, which already names
                one pressing. When nothing matches, the search widens to any vinyl and says so.
            </p>
        </div>

        <div class="stack-actions">
            <button class="btn btn-primary" @onclick="Begin">Start a stack</button>
            <a class="btn btn-secondary" href="scan">Scan one record instead</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <strong>A stack needs the live camera.</strong>
            @if (!_probe.IsSecureContext)
            {
                <span>
                    Browsers only grant camera access in a secure context, so this page needs
                    <code>localhost</code> or trusted HTTPS. Over plain HTTP from a phone,
                    scan records one at a time instead &mdash; that page can use the camera
                    app directly.
                </span>
            }
            else
            {
                <span>This browser exposes no camera. Scan records one at a time instead.</span>
            }
        </div>
        <div class="stack-actions">
            <a class="btn btn-primary" href="scan">Scan one record</a>
        </div>
    }
}
else if (_capturing)
{
    <div class="stack-stage">
        <video @ref="_video" playsinline muted autoplay></video>
        <div class="stack-box" @ref="_box"></div>
        <div class="stack-badge" @ref="_badge"></div>
        <div class="stack-count">@stack.Count / @stack.Capacity</div>
    </div>

    @if (stack.IsFull)
    {
        <div class="alert alert-success" role="alert">
            <strong>That is the lot.</strong>
            <span>@stack.Capacity records captured, which is as many as this stack takes.</span>
        </div>
    }

    <p class="stack-meta">Searching Discogs for @FormatSearched(stack.Format).</p>

    <div class="stack-shots">
        @foreach (var captured in stack.Scans)
        {
            <img src="@Photograph(captured)" alt="Record @captured.Position" />
        }
    </div>

    <div class="stack-actions">
        <button class="btn btn-primary" @onclick="Review" disabled="@stack.IsEmpty">
            @(stack.IsEmpty ? "Nothing captured yet" : $"Finished — identify {Counted(stack.Count)}")
        </button>
        <button class="btn btn-outline-danger" @onclick="Discard">Throw the stack away</button>
    </div>

    <p class="stack-meta">
        The photographs are held in memory only, until this stack ends. The stack can be
        picked up from another device, and one left untouched for a few hours is given up on.
    </p>
}
else
{
    <p class="stack-meta">
        Searched Discogs for @FormatSearched(stack.Format).
        @stack.ConfirmedCount of @Counted(stack.Count) added.
        @if (stack.PendingCount > 0)
        {
            <span>@stack.PendingCount still to deal with.</span>
        }
    </p>

    <div class="stack-defaults">
        <h2>True of the whole stack</h2>
        <p class="stack-meta">
            Applied to every record you confirm below. Condition and what you paid vary
            record by record, so they are not here &mdash; add those from a record's own
            page once it is in.
        </p>
        <div class="stack-default-fields">
            <div>
                <label class="form-label" for="from">Bought from</label>
                <input id="from" class="form-control" maxlength="200"
                       value="@stack.Defaults.PurchasedFrom" @onchange="SetPurchasedFrom" />
            </div>
            <div>
                <label class="form-label" for="where">Kept</label>
                <input id="where" class="form-control" maxlength="200"
                       value="@stack.Defaults.Location" @onchange="SetLocation" />
            </div>
        </div>
    </div>

    <ul class="stack-list">
        @foreach (var captured in stack.Scans)
        {
            <li class="stack-item @(captured.IsPending ? null : "resolved")">
                <img src="@Photograph(captured)" alt="Record @captured.Position" />

                <div class="stack-item-body">
                    <strong>Record @captured.Position</strong>

                    @switch (captured.Status)
                    {
                        case StackedScanStatus.Identifying:
                            <p class="stack-meta">Identifying&hellip;</p>
                            break;

                        case StackedScanStatus.Matched:
                            <p class="stack-meta">
                                Matched on @RouteDescription(captured.Result!.Route).
                                Pick the pressing you photographed.
                            </p>
                            @if (captured.Result!.IsOutsideFormat)
                            {
                                <p class="stack-meta stack-widened">
                                    Nothing matched as @FormatRecords(stack.Format), so these
                                    are from any vinyl. Check the format before you pick.
                                </p>
                            }
                            <ul class="candidate-list">
                                @foreach (var candidate in captured.Result!.Candidates)
                                {
                                    <li class="candidate">
                                        @if (!string.IsNullOrWhiteSpace(candidate.ThumbnailUrl))
                                        {
                                            <img src="@candidate.ThumbnailUrl" alt="" loading="lazy" />
                                        }
                                        <div class="candidate-detail">
                                            <strong>@candidate.ArtistName &mdash; @candidate.Title</strong>
                                            <span>@Describe(candidate)</span>
                                        </div>
                                        <button class="btn btn-outline-primary"
                                                disabled="@(_confirming == captured.Position)"
                                                @onclick="() => Confirm(captured, candidate)">
                                            @(_confirming == captured.Position ? "Adding…" : "This one")
                                        </button>
                                    </li>
                                }
                            </ul>
                            break;

                        case StackedScanStatus.NoMatch:
                            <p class="stack-meta">
                                @if (captured.Result!.SearchFailed)
                                {
                                    <span class="stack-failed">
                                        Discogs couldn't be reached, so this one may well be on
                                        Discogs. Check the connection, or that a Discogs token is
                                        set, and scan it again.
                                    </span>
                                }
                                else if (captured.Result!.Details.IsEmpty)
                                {
                                    <span>Nothing legible was read from this one.</span>
                                }
                                else
                                {
                                    <span>Read @DescribeDetails(captured.Result!.Details), but Discogs had nothing matching.</span>
                                }
                            </p>
                            break;

                        case StackedScanStatus.Unreadable:
                            <p class="stack-meta stack-failed">@captured.Failure</p>
                            break;

                        case StackedScanStatus.Confirmed:
                            <p class="stack-meta stack-done">Added to the collection.</p>
                            break;

                        case StackedScanStatus.Abandoned:
                            <p class="stack-meta">Given up on.</p>
                            break;
                    }
                </div>

                @if (captured.IsPending && captured.IsIdentified)
                {
                    <button class="btn btn-link stack-abandon" @onclick="() => Abandon(captured)">
                        Give up on this one
                    </button>
                }
            </li>
        }
    </ul>

    <div class="stack-actions">
        @if (stack.IsComplete)
        {
            <a class="btn btn-primary" href="collection">See my collection</a>
            <button class="btn btn-secondary" @onclick="Discard">Scan another stack</button>
        }
        else
        {
            <a class="btn btn-secondary" href="collection">My collection</a>
            <button class="btn btn-outline-danger" @onclick="Discard">
                Give up on the @Counted(stack.PendingCount) left
            </button>
        }
    </div>
}

@code {
    private const string ModulePath = "./js/detector.js";

    private const string PreferencesPath = "./js/preferences.js";

    /// <summary>Where this browser remembers the last Stack's Format.</summary>
    private const string FormatKey = "sevenbyseven.stack.format";

    /// <summary>Long edge in pixels, as for a single Scan: enough for a catalogue number.</summary>
    private const int MaxDimension = 1600;

    private const double JpegQuality = 0.85;

    private const long MaxImageBytes = 8L * 1024 * 1024;

    /// <summary>
    /// Each Scan's photograph as a data URL, fetched from the API once. The ones captured here
    /// are known already; the ones captured on another device are fetched as they appear.
    /// </summary>
    private readonly Dictionary<Guid, string> _photographs = [];

    private readonly HashSet<Guid> _fetching = [];

    private DotNetObjectReference<StackPage>? _self;
    private IJSObjectReference? _detector;
    private IJSObjectReference? _preferences;
    private ElementReference _video;
    private ElementReference _box;
    private ElementReference _badge;
    private CameraProbe? _probe;
    private StackLimits? _limits;
    private Format _format = Format.Vinyl;

    /// <summary>The camera is running on this page. Otherwise a Stack with Scans is shown for review.</summary>
    private bool _capturing;

    private int _confirming = -1;
    private string? _error;

    protected override void OnInitialized()
    {
        Watch.Changed += OnStackChanged;
        Watch.Start();
        FetchPhotographs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _detector = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _probe = await _detector.InvokeAsync<CameraProbe>("probe");
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Could not load the detector module.");
            _probe = new CameraProbe(false, false);
            _error = "The camera module failed to load.";
        }

        try
        {
            _limits = await Stacks.LimitsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The stack's limits could not be read.");
        }

        _format = await RememberedFormat();

        StateHasChanged();
    }

    /// <summary>
    /// The Format the last Stack on this device used. Anything unreadable — nothing
    /// stored, storage refused, a value from an older version — is Vinyl.
    /// </summary>
    private async Task<Format> RememberedFormat()
    {
        try
        {
            _preferences ??= await JS.InvokeAsync<IJSObjectReference>("import", PreferencesPath);
            var stored = await _preferences.InvokeAsync<string?>("read", FormatKey);

            return Enum.TryParse<Format>(stored, out var format) && Enum.IsDefined(format)
                ? format
                : Format.Vinyl;
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The remembered Format could not be read.");
            return Format.Vinyl;
        }
    }

    private async Task RememberFormat(Format format)
    {
        if (_preferences is null)
        {
            return;
        }

        try
        {
            await _preferences.InvokeVoidAsync("write", FormatKey, format.ToString());
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The Format could not be remembered.");
        }
    }

    private void SetFormat(ChangeEventArgs args)
    {
        if (Enum.TryParse<Format>(args.Value?.ToString(), out var format) && Enum.IsDefined(format))
        {
            _format = format;
        }
    }

    private async Task Begin()
    {
        if (_detector is null)
        {
            return;
        }

        _error = null;

        try
        {
            if (await Stacks.BeginAsync(_format) is not { } stack)
            {
                _error = "A stack is already in progress, with records still to deal with. It is shown below.";
                await Watch.RefreshAsync();
                return;
            }

            _photographs.Clear();
            await RememberFormat(stack.Format);
            await Watch.RefreshAsync();
            _capturing = true;

            // The video element only exists once this has re-rendered.
            StateHasChanged();
            await Task.Yield();

            _self ??= DotNetObjectReference.Create(this);
            await _detector.InvokeVoidAsync("start", _video, _box, _badge, Settings(stack.Capacity), _self);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "The camera could not be started.");
            _capturing = false;
            await Stacks.DiscardAsync();
            await Watch.RefreshAsync();
            _error = "The camera could not be started. Check the browser has permission.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The stack could not be started.");
            _capturing = false;
            _error = "The stack could not be started. The API may be unreachable.";
        }
    }

    /// <summary>The thresholds from configuration, plus what the capture itself needs.</summary>
    private object Settings(int capacity)
    {
        var detection = Detection.Value;

        return new
        {
            fgDelta = detection.ForegroundDelta,
            minCoverage = detection.MinCoverage,
            emptyCoverage = detection.EmptyCoverage,
            minFill = detection.MinFill,
            minContrast = detection.MinContrast,
            motionThreshold = detection.MotionThreshold,
            stillFrames = detection.StillFrames,
            emptyFrames = detection.EmptyFrames,
            calibrateFrames = detection.CalibrateFrames,
            clearFraction = detection.ClearFraction,
            settleOutFrames = detection.SettleOutFrames,
            maxStack = capacity,
            maxDimension = MaxDimension,
            jpegQuality = JpegQuality,
        };
    }

    /// <summary>
    /// The detector fired. Pulls the JPEG down the stream the browser opened — a
    /// photograph is far past the circuit's receive limit, so it cannot ride the
    /// interop call itself — and sends it to the Stack, which identifies it behind us.
    /// </summary>
    [JSInvokable]
    public async Task OnCaptured(CaptureResult result)
    {
        if (!_capturing || Watch.Current is not { IsFull: false } stack)
        {
            return;
        }

        await using var data = result.Data;

        try
        {
            if (data.Length > MaxImageBytes)
            {
                Logger.LogWarning("The browser offered {Length} bytes, past the ceiling.", data.Length);
                return;
            }

            await using var stream = await data.OpenReadStreamAsync(MaxImageBytes);
            using var buffer = new MemoryStream((int)data.Length);
            await stream.CopyToAsync(buffer);

            // Checked here as well as in the API, so a broken frame is never sent at all.
            var scan = Scan.FromJpeg(buffer.ToArray(), result.Width, result.Height, CaptureSource.Camera);

            var line = await Stacks.CaptureAsync(scan.Image, scan.Width, scan.Height);

            // Full, or gone: another device took the last place, or threw the Stack away.
            if (line is null || line.Position >= stack.Capacity)
            {
                await _detector!.InvokeVoidAsync("pause");
            }

            if (line is not null)
            {
                _photographs[line.Id] = scan.ToDataUrl();
            }

            await Watch.RefreshAsync();
        }
        catch (Exception ex) when (ex is JSException or IOException or FormatException or HttpRequestException)
        {
            Logger.LogError(ex, "A captured frame could not be taken into the stack.");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnCaptureFailed()
    {
        Logger.LogWarning("The browser could not hand over a captured frame.");
        return Task.CompletedTask;
    }

    /// <summary>Only a change of phase crosses the wire, not every frame.</summary>
    [JSInvokable]
    public Task OnPhaseChanged(string phase, string note)
    {
        Logger.LogDebug("Detector phase {Phase}: {Note}", phase, note);
        return Task.CompletedTask;
    }

    private async Task Review()
    {
        _capturing = false;
        await StopDetector();
    }

    private async Task Confirm(StackedScanLine captured, MatchCandidate candidate)
    {
        if (_confirming >= 0)
        {
            return;
        }

        _confirming = captured.Position;
        _error = null;

        try
        {
            // First time this pressing is confirmed it is fetched from Discogs and cached;
            // every time after, this is a read of our own catalogue.
            if (!await Stacks.ConfirmAsync(captured.Id, candidate.DiscogsReleaseId))
            {
                // The Scan is untouched unless another device dealt with it first, so it can
                // be tried again.
                _error = $"Record {captured.Position} could not be added. Discogs may be unreachable, "
                    + "or it was dealt with on another device. Nothing was added.";
            }

            await Watch.RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Confirming record {Position} failed.", captured.Position);
            _error = "That could not be added. The API may be unreachable.";
        }
        finally
        {
            _confirming = -1;
        }
    }

    private Task Abandon(StackedScanLine captured) => Change(() => Stacks.AbandonAsync(captured.Id));

    private Task SetPurchasedFrom(ChangeEventArgs args) =>
        SetDefaults(Watch.Current!.Defaults with { PurchasedFrom = args.Value?.ToString() });

    private Task SetLocation(ChangeEventArgs args) =>
        SetDefaults(Watch.Current!.Defaults with { Location = args.Value?.ToString() });

    private Task SetDefaults(StackDefaults defaults) => Change(() => Stacks.SetDefaultsAsync(defaults));

    private async Task Discard()
    {
        _capturing = false;
        await StopDetector();
        await Change(() => Stacks.DiscardAsync());
        _photographs.Clear();
    }

    /// <summary>
    /// Makes one change and reads the Stack back. False from the API means the Stack or Scan
    /// had already gone, which the read shows for itself.
    /// </summary>
    private async Task Change(Func<Task<bool>> change)
    {
        _error = null;

        try
        {
            await change();
            await Watch.RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Changing the stack failed.");
            _error = "That could not be saved. The API may be unreachable.";
        }
    }

    private async Task StopDetector()
    {
        if (_detector is null)
        {
            return;
        }

        try
        {
            await _detector.InvokeVoidAsync("stop");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; the camera went with the page.
        }
    }

    /// <summary>
    /// The Stack changed, here or anywhere. One that went from under a running camera —
    /// thrown away on another device, or abandoned for being left — stops the camera too.
    /// </summary>
    private void OnStackChanged()
    {
        if (_capturing && Watch.Current is null)
        {
            _capturing = false;
            _ = InvokeAsync(StopDetector);
        }

        FetchPhotographs();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Starts fetching any photograph this page has not seen, each only once.</summary>
    private void FetchPhotographs()
    {
        foreach (var scan in Watch.Current?.Scans ?? [])
        {
            if (_photographs.ContainsKey(scan.Id) || !_fetching.Add(scan.Id))
            {
                continue;
            }

            _ = FetchPhotographAsync(scan.Id);
        }
    }

    private async Task FetchPhotographAsync(Guid scanId)
    {
        try
        {
            if (await Stacks.PhotographAsync(scanId) is { } jpeg)
            {
                await InvokeAsync(() =>
                {
                    _photographs[scanId] = $"data:image/jpeg;base64,{Convert.ToBase64String(jpeg)}";
                    StateHasChanged();
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The photograph of scan {ScanId} could not be fetched.", scanId);
            await InvokeAsync(() => _fetching.Remove(scanId));
        }
    }

    private string? Photograph(StackedScanLine scan) => _photographs.GetValueOrDefault(scan.Id);

    private static string Counted(int count) => count == 1 ? "1 record" : $"{count} records";

    private static string Describe(MatchCandidate candidate) =>
        string.Join(" · ", new[]
        {
            candidate.LabelName,
            candidate.CatalogueNumber,
            candidate.Country,
            candidate.Year?.ToString(),
            candidate.FormatDescription,
        }.Where(part => !string.IsNullOrWhiteSpace(part)));

    private static string DescribeDetails(SleeveDetails details) =>
        string.Join(", ", new[]
        {
            details.ArtistName,
            details.Title,
            details.CatalogueNumber,
            details.Barcode,
        }.Where(part => !string.IsNullOrWhiteSpace(part)));

    private static string FormatChoice(Format format) => format switch
    {
        Format.SevenInch => "7\"",
        Format.LP => "LP",
        Format.TwelveInch => "12\" single",
        Format.TenInch => "10\"",
        _ => "Any vinyl",
    };

    private static string FormatRecords(Format format) => format switch
    {
        Format.SevenInch => "7\" records",
        Format.LP => "LPs",
        Format.TwelveInch => "12\" singles",
        Format.TenInch => "10\" records",
        _ => "any vinyl",
    };

    /// <summary>A barcode is never narrowed, so a narrowed Format says so.</summary>
    private static string FormatSearched(Format format) =>
        format is Format.Vinyl ? FormatRecords(format) : $"{FormatRecords(format)} only, except by barcode";

    private static string RouteDescription(IdentificationRoute route) => route switch
    {
        IdentificationRoute.Barcode => "the barcode",
        IdentificationRoute.CatalogueNumber => "the catalogue number",
        IdentificationRoute.ArtistAndTitle => "artist and title",
        _ => "nothing in particular",
    };

    public async ValueTask DisposeAsync()
    {
        Watch.Changed -= OnStackChanged;

        await StopDetector();

        foreach (var module in new[] { _detector, _preferences })
        {
            if (module is null)
            {
                continue;
            }

            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private sealed record CameraProbe(bool HasMediaDevices, bool IsSecureContext);

    public sealed record CaptureResult(IJSStreamReference Data, int Width, int Height);
}
