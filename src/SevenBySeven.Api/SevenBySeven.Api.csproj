<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SevenBySeven.ServiceDefaults\SevenBySeven.ServiceDefaults.csproj" />
    <!-- Every module is composed into the API; ModuleDiscovery finds them at startup. -->
    <ProjectReference Include="..\Modules\*\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SevenBySeven.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The same store the web app used, so credentials already set keep working. -->
    <UserSecretsId>f2d3bf17-15e7-44ca-93e5-1e606a6d2ac8</UserSecretsId>
  </PropertyGroup>

</Project>
