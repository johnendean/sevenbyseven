<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SevenBySeven.ServiceDefaults\SevenBySeven.ServiceDefaults.csproj" />
    <!-- Every module is composed into the API; ModuleDiscovery finds them at startup. -->
    <ProjectReference Include="..\Modules\*\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
