@page "/collection"
@inject IVinylCollection Collection
@inject IPlayHistory Plays

<PageTitle>My collection</PageTitle>

<h1>My collection</h1>

@if (_copies is null)
{
    <p class="collection-meta">Reading the shelves&hellip;</p>
}
else if (_copies.Count == 0)
{
    <p>Nothing here yet.</p>
    <p class="collection-meta">
        Photograph a sleeve or centre label and the record is identified against Discogs,
        then added here once you confirm which pressing it is.
    </p>
    <p><a class="btn btn-primary" href="scan">Scan a record</a></p>
}
else
{
    <p class="collection-meta">
        @Counted(_copies.Count)
        @if (HidingRepeats)
        {
            <text> &middot; @Hidden() &middot; <a href="collection">Show everything</a></text>
        }
        else
        {
            <text> &middot; <a href="collection?hide=repeats">Hide recent repeats</a></text>
        }
    </p>

    <ul class="copy-list">
        @foreach (var copy in Shown())
        {
            var standing = _standings[copy.Id];

            <li class="copy">
                <a class="copy-link" href="collection/@copy.Id">
                    @if (copy.Release?.ThumbnailUrl is { Length: > 0 } thumbnail)
                    {
                        <img src="@thumbnail" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="copy-sleeve-missing" aria-hidden="true"></span>
                    }

                    <span class="copy-detail">
                        <strong>@copy.Release?.ArtistName &mdash; @copy.Release?.Title</strong>
                        <span>@copy.Release?.Pressing</span>
                        @if (standing.TimesPlayed > 0)
                        {
                            <span>@standing.Describe()</span>
                        }
                    </span>
                </a>

                @if (standing.Repeat is not Repeat.None)
                {
                    <span class="copy-repeat copy-repeat-@standing.Repeat.ToString().ToLowerInvariant()"
                          title="@standing.Repeat.Describe()">@standing.Repeat.Abbreviation()</span>
                }

                @if (copy.MediaCondition is { } grade)
                {
                    <span class="copy-grade" title="@($"Media: {grade.Describe()}")">@grade.Abbreviation()</span>
                }
            </li>
        }
    </ul>

    <p><a class="btn btn-primary" href="scan">Scan another</a></p>
}

@code {
    /// <summary>"repeats" leaves out anything played at a recent Gig, for choosing what to take to the next one.</summary>
    [SupplyParameterFromQuery(Name = "hide")]
    public string? Hide { get; set; }

    private IReadOnlyList<Copy>? _copies;
    private IReadOnlyDictionary<Guid, PlayStanding> _standings = new Dictionary<Guid, PlayStanding>();

    private bool HidingRepeats => string.Equals(Hide, "repeats", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var copies = await Collection.ListAsync();
        _standings = await Plays.StandingsAsync([.. copies.Select(copy => copy.Id)]);
        _copies = copies;
    }

    private IEnumerable<Copy> Shown() =>
        HidingRepeats ? _copies!.Where(copy => _standings[copy.Id].Repeat is Repeat.None) : _copies!;

    private string Hidden()
    {
        var hidden = _copies!.Count - Shown().Count();

        return hidden == 1 ? "1 recent repeat hidden" : $"{hidden} recent repeats hidden";
    }

    private static string Counted(int count) => count == 1 ? "1 record" : $"{count} records";
}
